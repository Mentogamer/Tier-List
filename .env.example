# ---- Discord (required for the bot) ----
DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
GUILD_ID=your-server-id

# ---- Database ----
# SQLite file (created automatically). Prisma-style "file:" prefix is accepted.
DATABASE_URL=file:./data/tiertest.db

# ---- Web panel ----
WEB_PORT=3000
WEB_HOST=0.0.0.0
# Long random string (>= 16 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Public URL of the site (used for links + OAuth redirect). Use https in production.
WEB_PUBLIC_URL=http://localhost:3000

# ---- Player login on the website (Discord OAuth2) - optional ----
# Developer Portal > OAuth2 > Client Secret. Add redirect: <WEB_PUBLIC_URL>/auth/callback
DISCORD_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# ---- Optional ----
# Comma-separated role IDs that count as staff (can see tickets + logs). Administrators always can.
STAFF_ROLE_IDS=
# Comma-separated role IDs allowed to open/close/clear queues (besides admins and each gamemode's testers)
QUEUE_MANAGER_ROLE_IDS=
# Register slash commands automatically when the bot starts (true/false)
AUTO_REGISTER_COMMANDS=true
# Seconds before a finished ticket channel is deleted
TICKET_CLOSE_DELAY_SECONDS=10
