{
  "name": "mentos-tier-test-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Mento's Tier Test Bot - Discord tier testing bot with queue, tickets, roles and web results panel",
  "main": "dist/index.js",
  "engines": { "node": ">=18.17" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "migrate": "node dist/db/migrate-cli.js",
    "register": "node dist/register.js",
    "start": "node dist/index.js",
    "start:bot": "node dist/index.js --bot-only",
    "start:web": "node dist/index.js --web-only",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
